# Local Docker Compose defaults. Replace every credential outside local development.
AGENTFLOW_ENVIRONMENT=local
AGENTFLOW_HOST=0.0.0.0
AGENTFLOW_PORT=8000
AGENTFLOW_LOG_LEVEL=INFO
AGENTFLOW_JSON_LOGS=true
AGENTFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

AGENTFLOW_REPOSITORY_BACKEND=postgres
AGENTFLOW_DATABASE_URL=postgresql://agentflow:agentflow@postgres:5432/agentflow
AGENTFLOW_CACHE_BACKEND=redis
AGENTFLOW_REDIS_URL=redis://redis:6379/0

AGENTFLOW_STORAGE_BACKEND=s3
AGENTFLOW_S3_BUCKET=agentflow-documents
AGENTFLOW_S3_REGION=us-west-2
AGENTFLOW_S3_ENDPOINT_URL=http://minio:9000
AGENTFLOW_S3_ACCESS_KEY_ID=agentflow-local
AGENTFLOW_S3_SECRET_ACCESS_KEY=agentflow-local-only
AGENTFLOW_S3_FORCE_PATH_STYLE=true
AGENTFLOW_ALLOWED_EXTENSIONS=[".txt",".md",".pdf",".docx"]

AGENTFLOW_EMBEDDING_PROVIDER=local
AGENTFLOW_RESPONSE_PROVIDER=local
AGENTFLOW_EMBEDDED_WORKER=false

# Optional real provider settings. Leave unset for the deterministic local demo.
# AGENTFLOW_OPENAI_API_KEY=
# AGENTFLOW_OPENAI_MODEL=
# AGENTFLOW_OPENAI_EMBEDDING_MODEL=
